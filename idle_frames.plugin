__id__ = "idle_frames"
__name__ = "Background Battery Fix"
__description__ = "Stops XF asking for a new screen frame 120 times a second when nothing is moving, in the background too. Cuts the background CPU use that makes Android close XF. Made by [firestarter1996](https://github.com/firestarter1996)."
__author__ = "firestarter1996"
__version__ = "1.0.0"
__min_version__ = "12.5.1"

# XF's Choreographer60FpsContent posts a frame callback on every vsync for the life of the app,
# even with nothing registered and with XF in the background. On a 120 Hz phone that wakes the
# main thread 120 times a second all day; Android's background CPU limit then kills XF
# ("excessive cpu"). The Java part (embedded below) stops that loop when there is nothing to do
# and restarts it the instant any animation or invalidation is added. The hook runs in Java, no
# Python on the frame path. Logcat tag XFIdle.

import base64
import zlib

from java import jclass
from base_plugin import BasePlugin
from ui.settings import Header, Text

ENTRY = "com.firestarter.xfidle.IdleFrames"


def _log(msg):
    try:
        jclass("android.util.Log").i("XFIdle", str(msg))
    except Exception:
        pass


class IdleFramesPlugin(BasePlugin):

    def create_settings(self):
        st = "not running"
        try:
            if self.core is not None:
                st = str(self.core.getMethod("stats").invoke(None))
        except Exception:
            pass
        return [Header(text="Background Battery Fix"), Text(text="Status", subtext=st)]

    def on_plugin_load(self):
        self.core = None
        try:
            ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
            with open(__file__, "r", encoding="utf-8") as fh:
                text = fh.read()
            block = text.rsplit("# __DEX_BEGIN__", 1)[1].split("# __DEX_END__", 1)[0]
            payload = "".join(l.strip()[1:].strip() for l in block.splitlines() if l.strip().startswith("#"))
            data = zlib.decompress(base64.b64decode(payload))
            Loader = jclass("dalvik.system.InMemoryDexClassLoader")
            self.loader = Loader(jclass("java.nio.ByteBuffer").wrap(data), ctx.getClassLoader())
            self.core = self.loader.loadClass(ENTRY)
            AU = jclass("org.telegram.messenger.AndroidUtilities")
            from android_utils import R
            self._r = R(lambda: _log("install: %s" % self.core.getMethod("install", jclass("java.lang.ClassLoader")).invoke(None, ctx.getClassLoader())))
            AU.runOnUIThread(self._r)
        except Exception as e:
            self.core = None
            _log("load: %s" % e)

    def on_plugin_unload(self):
        try:
            if self.core is not None:
                self.core.getMethod("uninstall").invoke(None)
                _log("uninstalled")
        except Exception as e:
            _log("unload: %s" % e)
        self.core = None

